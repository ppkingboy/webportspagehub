// 获取主机地址之后的目录，如： DBSP/js/main.js
var PATHNAME = window.document.location.pathname;

// 获取带"/"的项目名，如：/DBSP
var PROJECTNAME = PATHNAME.substring(0, PATHNAME.substr(1).indexOf('/') + 1);

var dbsec = {
    root: "dist", // 目录 : src 开发模式, dist 上线送测模式;
    uiCore: "vue",
    moduleRoot: PROJECTNAME + "/pages", // 模块根目录
    css: ".css", // 样式后缀 : .less 开发模式, .css 上线送测模式;
    environment: "production", // 请求接口 : local 模拟JSON ， production 链接 JAVA接口;
    debug: true, // 是否开启debug;
    defaultPage: "overview", // 默认页面
skin:"dbf-cyan",
    langType: "zh-CN", // 语言;
    rootPath: PROJECTNAME, // 系统根目录
    staticPath: PROJECTNAME,
    logo:"", // 系统logo
    title:"DBSCREEN SYSTEM", // 系统title
    components:[// 顶部控件
        "loginInfo",
        "heartBeat",
        "msRuleChange", // 规则变更
        "msAlarm",//系统告警+1
        "msLanguage",
        "msUserInfo", // 用户登陆信息 及 修改用户信息
        "msLogout", // 用户注销
        "pageFooter",//页脚
        "singleDbMonitor", // 单库监控
        "ukey2",//ukey2
    ],
    navOff: true, // 关闭导航
    session: true, // sessionTimeout
    token:true,
    sessionTokenValue: false, // 防csrf的token校验值;
    delay: 500, // 延迟加载时间 ;
    shade: [0.5, "#fff"], // 弹出框 颜色及透明度;
    lib: [], // 会在插件配置文件中 配置需要加载的 框架 例如 jqgrid,datatables...
    loadingClose:false,// loading 为 true 会关闭产品 loading
    skinClose:false,// skinClose 为 true 模块将使用兼容模式 将关闭皮肤 ，不引用样式 及 bootstrap
    appRoot: this.appRoot || '',
    appHelper: this.appHelper || '',
    acrossPath: '',
    ajaxUrl: {
        "local": {
            "settimeout": 500
        },
        "production": {
            "settimeout": 500
        }
    },
    addAjaxUrl: function(obj) {
        if (!obj) obj = {}
        var uObject = obj[dbsec.environment];
        if (uObject && typeof(uObject) === "object") {
            for (var key in uObject) {
                if (uObject[key]) {
                    dbsec.ajaxUrl[dbsec.environment][key] = uObject[key];
                }
            }
        }
    },
    langList: [{title:"中文",value:"zh-CN"},{title:"English",value:"en-US"},{title:"繁體中文",value:"zh-TW"}]
};
if (typeof module != 'undefined') {
    module.exports = dbsec;
}