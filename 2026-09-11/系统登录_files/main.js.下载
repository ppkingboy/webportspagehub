    iframeLoad: function(pageId) {
        var p = pageId;
        if ( dbsec && dbsec.uiCore == 'vue' && p.indexOf('v_') === 0 ) {
            var pvue = p.substring(2).split('_').join('/');
            var newParam = "";
            let request = localStorage.getItem(p) ? JSON.parse(localStorage.getItem(p)) : {};
            if(Object.keys(request).length > 0){
                if(request.query){
                    newParam += '?'+request.query;
                    localStorage.removeItem(p);//query的是加到url里，传递后清除
                }else{
                    //params传递的在vue路由里面接收后清除
                    //newParam += '/'+request.params;
                }
            }
            p = 'pagesvue/index.html#/' + pvue.split('-')[0] + newParam;
        } else {
            p = 'web_frame.html#!/' + p;
        }
        dbsecSystem.main.contentPage = "<iframe frameborder=\'0\' border=\'0\' id=\'iframeReport\' src=\'" + p + "\' class=\'iframe-content\'></iframe>'";
        if (dbsec.navLeft) {
            dbsecSystem.main.contentPage = "<iframe frameborder=\'0\' border=\'0\' id=\'iframeReport\' src=\'" + p + "\' class=\'iframe-content\' style='padding-left: 224px'></iframe>'";
        }
        dbsecSystem.main.contentShow = {
            visibility: "visible"
        };
        if(isIE){
            avalon.scan(document.body);
        }
    },
    ajaxMonitor: function(stateCode, type) {
        switch (stateCode) {
            case (500): //服务器系统内部错误
                if (type) {
                    window.location.href = dbsec.staticPath + "/login.html";
                } else {
                    dbsecSystem.sessionTimeout("服务器系统内部错误！");
                }
                break;
            case (401): //未登录
                if (type) {
                    window.location.href = dbsec.staticPath + "/login.html";
                } else {
                    dbsecSystem.sessionTimeout("没有登录！");
                }
                break;
            case (499): //用户过期
                if (type) {
                    window.location.href = dbsec.staticPath + "/login.html?s=out";
                } else {
                    dbsecSystem.sessionTimeout("用户过期！");
                }
                break;
            case (403): //无权限执行此操作
                if (type) {
                    window.location.href = dbsec.staticPath + "/login.html";
                } else {
                    dbsecSystem.alert('无权限执行此操作');
                }
                break;
            case (408): //请求超时
                if (type) {
                    window.location.href = dbsec.staticPath + "/login.html";
                } else {
                    dbsecSystem.sessionTimeout("请求超时！");
                }
                break;
            default: //未知错误
                if (type) {
                    //window.location.href = dbsec.staticPath + "/login.html";
                } else {
                    dbsecSystem.sessionTimeout;
                    ("未知错误！");
                }
        }
    },
    logoutTimer: '',
    sessionTimeout: function(msg) {
        var num = 10;
        var txt = "<p id='sessionTimeout'>" + msg + " <b>" + num + "</b> 秒 后返回登录页！</p>";
        var _that = this;
        if (!this.logoutTimer) {
            parent.layer.alert(txt, {
                icon: 0,
                skin: 'layer-ext-moon',
                closeBtn: 0
            }, function(index) {
                parent.window.location.href = dbsec.staticPath + '/login.html';
                layer.close(index);
            });
            reduceCount();
            this.logoutTimer = setInterval(function() {
                reduceCount();
            }, 1000);
        }

        function reduceCount() {
            parent.$("#sessionTimeout").find("b").text(num);
            if (num == 0) {
                clearInterval(_that.logoutTimer);
                parent.window.location.href = dbsec.staticPath + '/login.html?s=out';
            }
            num--;
        }
        // 某些情况下，弹出会话过期后会再次弹出loading层，导致按钮不可用
        setInterval(function() {
            dbsecSystem.loading(false);
        }, 10);
    },
    locationHref: function(info) {
        if (!info || info == "") {
            return;
        }
        var start = info.indexOf("#!/") == -1 ? "#!/" : "";
        window.location.href = start + info;
        return false;
    },
