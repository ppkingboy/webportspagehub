    get: (function() {
        var url = decodeURI(window.document.location.href.toString());
        url = url.replace(/\\\\/g, "\\");
        url = url.replace(/&#92;/g, "\\");
        url = url.replace(/&quot;/g, "\"");
        url = url.replace(/&#39;/g, "\'");
        url = url.replace(/&gt;/g, ">");
        url = url.replace(/&lt;/g, "<");
        url = url.replace(/&amp;/g, "&");
        var u = url.split("?");
        if (typeof(u[1]) == "string") {
            u = u[1].split("&");
            var get = {};
            for (var i in u) {
                var j = u[i].split("=");
                get[j[0]] = j[1];
            }
            return get;
        } else {
            return {};
        }
    })(),
    hash: function() {
