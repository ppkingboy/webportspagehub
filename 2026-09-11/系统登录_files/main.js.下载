    navigations:{},//导航集合
    getNavigations: function(){
        var navs = this.topNav && this.topNav.topNavList;
        var newNavObj = {};
        if(navs.length){
            for(var i = 0; i < navs.length; i ++){
                var submenu = navs[i].submenu,
                    menuId = navs[i].menuid,
                    url = navs[i].url;
                if(submenu.length){
                    for(var ii = 0; ii < submenu.length; ii ++){
                        var menu = submenu[ii],
                            menuId2 = menu.menuid,
                            url2 = menu.url;
                        newNavObj[url2] = menuId2;
                    }
                }else{
                    newNavObj[url] = menuId;
                }
            }
        }
        this.navigations = newNavObj;
    },
    init: function() {
        for (var i = 0; i < dbsecSystem.scripts.length; i++) {
            var pageid = dbsecSystem.scripts[i].getAttribute("pageid");
            if (pageid) {
                dbsecSystem.loadPageScript(pageid);
            }
        }
    },
    timer: [],
    // 全局定时器组
