                var hash = dbsecSystem.hash();
                if (hash.indexOf(".js") != -1) {
                    var bootstrap = dbsecSystem.get.bootstrap;
                    depAry = baseDep.concat(dCsss);
                    if(bootstrap=="false"){
                        depAry = ['language','avalon', 'mmRouter', 'jquery', 'layer', 'language-config'];
                    }
                    isFramePage = [hash.replace('#!/', '')];
                } else {
                    var dConfig = [dbsec.moduleRoot + "/" + pageV + "/config.js"];
                    depAry = baseDep.concat(dConfig, dCsss);
                };
                dbsec.appRoot = dbsec.moduleRoot + "/" + pageV;
                dbsec.appHelper = dbsec.moduleRoot + "/common/helper";
                require(depAry, function() {
                    layer.config({
                        path: dbsec.root + '/lib/layer/'
                    });
                    if (pageV) {
                        var noStyle = avalon.define({
                            $id: "noStyle",
                            contentPage: "",
