                break;
            case "noStyle":
                var pageV = dbsecSystem.get.page;
                var baseDep = ['language','avalon', 'mmRouter', 'jquery', 'layer', 'bootstrap', 'language-config'];
                var dCsss = ['style!skinCSS', 'style!bootstrapCSS'];
                var depAry = [];
                var isFramePage = [];
