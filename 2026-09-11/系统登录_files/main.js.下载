    loadPageScript: function(pageId) {
        var _thatParent = parent.dbsecSystem?parent.dbsecSystem:this;
        pageId = (pageId == 'detail' ? 'noStyle' : pageId);
        var pageIdArr = pageId.replace(/[&\|\\\//*^%$#@]/g, "").split("-");
        if( typeof dbsecSystem.routeCallback == "function" && dbsecSystem.routeCallback(pageIdArr) ){
            return false;
        }
        switch (pageId) {
            case "myApp":
                document.getElementsByTagName('body')[0].className = "body_" + _lang.replace("-","_").toLowerCase();
                var innerIframeDepList = ['language','avalon', 'mmRouter', 'jquery', 'layer', 'language-config','style!skinCSS'];
                var pathname = window.location.pathname.replace(/[&\|\\\//*^%$#@\-]/g, "");
                if (pathname.indexOf("web_frame.html") > -1) {
                    innerIframeDepList = ['language','avalon', 'mmRouter', 'jquery', 'layer', 'language-config'];
                }
                (dbsec.session !== false) && (innerIframeDepList.push('sessionTimeout'));
                require(innerIframeDepList,
                    function() {
                        avalon.config({
                            debug: dbsec.debug
                        });
                        dbsec.myApp = avalon.define({
                            $id: 'myApp',
                            contentPage: "",
                            L: LANGUAGE,
                            langList:dbsec.langList,
                            authLogin: false,//认证
                            productCode: _thatParent.paramData.productCode,//产品类型
                            oem: _thatParent.paramData.oemCode,//oem,
                            isTesting:_thatParent.paramData.isTesting
                        });
                        avalon.router.add("/:tab", dbsecSystem.callback);
                        //启动路由监听
                        avalon.history.start({
                            root: "/" + dbsec.defaultPage
                        });
                        dbsecSystem.loading(true);
                        layer.config({
                            path: dbsec.root + '/lib/layer/'
                        });
                        var hash = dbsecSystem.hash();
                        //首次加载跳转到第一个界面
                        //                        if (!hash) {
                        //                            dbsecSystem.locationHref(dbsec.defaultPage);
                        //                        }
                    });
                break;
            case "login":
                // 初期化
                require(['style!loginCSS', 'login', 'style!fontawesome', 'des', 'vikey'],
                    function(undefined, login) {
                        layer.config({
                            path: dbsec.root + '/lib/layer/'
                        });
                        login.init();
                    });
                break;
            case "index":
                document.getElementsByTagName('body')[0].className = "body_" + _lang.replace("-","_").toLowerCase();
                var outerIframeDepList = ['index', 'style!indexCSS'];
