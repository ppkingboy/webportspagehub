    ajax: function(o) {
        var defaults = {
            async: true,
            type: "post",
            dataType: "json",
            contentType: "application/x-www-form-urlencoded; charset=UTF-8",
            cache: false
        };
        var settings;
        var args = {};
        var cb1, cb2;
        if (o && typeof o == "object") {
            settings = $.extend({}, defaults, o);
        } else if (arguments.length > 1) {
            try {
                args.url = arguments[0] + '?t='+ Math.random();
                args.success = arguments[1];
                args.data = arguments[2] ? arguments[2] : {};
                args.async = typeof arguments[3] == "boolean" ? arguments[3] : false;
                args.type = arguments[4] ? arguments[4] : "post";
                args.error = arguments[5] ? arguments[5] : hideLoading;
                settings = $.extend({}, defaults, args);
            } catch (e) {
                console.log("system ajax error!");
                return;
            }
        }
        settings.url = dbsec.acrossPath + settings.url;
        if (!settings.success) {
            settings.success = hideLoading;
        } else {
            cb1 = settings.success;
            settings.success = function(data) {
                cb1(data);
            };
        }
        if (!settings.error) {
            settings.error = hideLoading;
        } else {
            cb2 = settings.error;
            settings.error = function(xhr, errorText, errorType) {
                cb2(errorText);
            };
        }
        $.ajax(settings);

        function hideLoading() {
            if (top.dbsecSystem.pageloading) {
                top.dbsecSystem.loading(false);
            }
            if (dbsecSystem.pageloading) {
                dbsecSystem.loading(false);
            }
        }
    },
