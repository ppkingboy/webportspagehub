    alert: function(content, callback, options) { //提示信息
        // 缺省参数
        var delay = 2000;
        var timer;
        var defaultOptions = {
            title: [LANGUAGE.PROMPTMESSAGE.SUCCESSTITLE, 'font-size: 13px;font-weight: normal;'],
            icon: 1,
            time: delay, // 2s后自动关闭,
            btn: [],
            skin: 'layer-ext-moon'
        };
        var _options = options ? $.extend(defaultOptions, options) : defaultOptions;
        if(_options.cancel && _options.delayCallback){
            timer = setTimeout(callback,delay);
            _options.cancel = function(index,olayer){
                if(timer){
                    clearTimeout(timer);
                }
                if (typeof callback === "function") {
                    callback(index,olayer);
                }
            }
            layer.alert(content, _options);
        }else{
            layer.alert(content, _options);
            if (typeof callback === "function") {
                callback();
            }
        }
    },
    alertError: function(content, callback, options) {
