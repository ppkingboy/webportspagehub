var	appSystem = {
	newScript:function(url,index,attr){
		var newScript = document.createElement("script");
		newScript.async = true;
		if(attr){
			for(var i in attr){
				newScript.setAttribute(attr[i].name,attr[i].value);
			}
		}
		newScript.src = url;
		var s0 = document.getElementsByTagName('script')[index];
		s0.parentNode.insertBefore(newScript,s0);	
	},
	newStyle:function(url,index,attr){
		var newStyle = document.createElement('link');
		newStyle.href = url;
		if(attr){
			for(var i in attr){
				newScript.setAttribute(attr[i].name,attr[i].value);
			}
		}
		newStyle.rel = 'stylesheet';
		newStyle.type = 'text/css';
		var c0 = document.getElementsByTagName('link')[index];
		c0.parentNode.insertBefore(newStyle,c0);
	}
}
//加载 iconfont
appSystem.newStyle(
		dbsec.root+"/public/iconfont/iconfont.css",
		0
);
// 加载 require 和  main
appSystem.newScript(
		dbsec.root+"/lib/require.js?v=1.0",
		1,
		[{
			name:"data-main",
			value:dbsec.root+"/main.js?v=1.0"
		},{
			name:"async",
			value:"async"
		},{
			name:"defer",
			value:"defer"
		}]
);
