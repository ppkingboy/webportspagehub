    /**
     * version -1:目前版本 0:目前版本 1:销售版本
     * */
    function getTheme(key, oem, testing, version) {
        var themePro = feature[key] ? feature[key] : feature[0];
        var imgRootPath = dbsec.rootPath + "/project/images/";
        var baseUrl,
            _bannerImg,
            _bkImg,
            _logoImage,
            _versionImg;
        if (oem == '0') { //主干版本
            if (testing == 1) { //保密局-目前
                if (version == 0) { //保密局-目前
                    setObjectAttr(themePro, 'testing', 0);
                } else if (version == 1) { //保密局-新版
                    setObjectAttr(themePro, 'testing', 1);
                }
            } else if (testing == 0) {
                if (version == 0) { //主干-目前
                    setObjectAttr(themePro, 'version', 0);
                } else if (version == 2) { //销售
                    setObjectAttr(themePro, 'version', 2);

                }
            } else if (testing == 2 && key == 2) { //数据库安全防护平台特殊处理testing=2
                setObjectAttr(themePro, 'testing', 2);
            }
        } else { //oem
            if (themePro['oem'][oem]) {
                setObjectAttr(themePro, 'oem', oem);
            }
        }
        baseUrl = imgRootPath + themePro.imgDir,
            _bannerImg = themePro.bannerImg,
            _bkImg = themePro.bkImg,
            _logoImage = themePro.logoImage,
            _versionImg = themePro.versionImg;

        themePro.bannerImg = _bannerImg ? (baseUrl + _bannerImg) : '';
        themePro.bkImg = _bkImg ? (baseUrl + _bkImg) : '';
        themePro.logoImage = _logoImage ? (baseUrl + _logoImage) : '';
        if (oem == '0' || oem == '3') {
            themePro.versionImg = _versionImg ? (imgRootPath + _versionImg) : '';
        } else {
            themePro.versionImg = _versionImg ? (baseUrl + _versionImg) : '';
        }
        if (themePro.layout == 2) {
            if(!themePro.map){
                themePro.map = 'login-map.png';
            }
            themePro.leftBanner = baseUrl + themePro.map;
        }
        delete themePro.oem;
        delete themePro.version;
        delete themePro.testing;
        return themePro;
    }
    /**重写属性*/
    function setObjectAttr(oct, attr, value) {
        var __attrDist = oct[attr],
            __attrObject;
        if (!__attrDist) {
            return;
        }
        __attrObject = __attrDist[value];
        if (!__attrObject) {
            return;
        }
        for (var k in __attrObject) {
            var cvalue = __attrObject[k];
            if(k === 'versionImg' && __attrObject.imgDir){
                oct[k] = __attrObject.imgDir + cvalue;
            }else{
                oct[k] = cvalue;
            }
        }
    }
    return {
        getTheme: getTheme
    };
